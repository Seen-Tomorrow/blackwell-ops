+//
+// engine telemetry SSE (/events/sse)
+//
+// Additive fan-out of the events the per-request streams already carry, for
+// observers that do not own the request (fusion meters, bench, the ops UI).
+// Values come from the same slot counters that produce the per-request
+// prompt_progress / timings payloads, so they are comparable with llama-bench.
+// With no subscriber attached every call is a no-op.
+//
+namespace server_events {
+
+// true when at least one /events/sse connection is attached, emitters check
+// this to skip building a payload on the hot path
+bool enabled();
+
+void publish_prompt_progress(int id_slot, int n_total, int n_cache, int n_processed, double time_ms);
+
+// lib_* are the library's own counters (llama_perf_context t_p_eval_ms and
+// n_p_eval) across this request, the same numbers llama-bench reports
+void publish_request_end(int id_slot, int id_task, const server_slot_stats & stats,
+        double lib_prompt_ms, int64_t lib_tokens_evaluated);
+
+// throttled decode progress, so a live TG meter does not have to poll /slots
+void publish_gen_progress(int id_slot, uint64_t n_decoded, double gen_ms, double tps);
+
+void publish_state(int id_slot, const char * phase, int busy, int peak, int n_ctx, int n_ctx_used);
+
+} // namespace server_events
+
