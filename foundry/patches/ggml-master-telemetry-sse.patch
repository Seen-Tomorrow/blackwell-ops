+    //
+    // engine telemetry (/events/sse)
+    //
+    // Read-only mirrors of the counters the per-request stream already exposes.
+    // Nothing below runs unless an observer is attached.
+    //
+
+    int n_busy_peak = 0;
+
+    // llama_perf_context() snapshot taken when each slot started its prompt
+    std::map<int, llama_perf_context_data> perf_prompt_start;
+
+    // last gen_progress emitted per slot, us
+    std::map<int, int64_t> t_gen_emit_last;
+
+    static const char * telemetry_phase(slot_state state) {
+        switch (state) {
+            case SLOT_STATE_IDLE:       return "IDLE";
+            case SLOT_STATE_WAIT_OTHER: return "WAIT";
+            case SLOT_STATE_GENERATING: return "TG";
+            default:                    return "PP";
+        }
+    }
+
+    void emit_state(const server_slot & slot) {
+        if (!server_events::enabled()) {
+            return;
+        }
+
+        int busy = 0;
+        for (const auto & s : slots) {
+            if (s.is_processing()) {
+                busy++;
+            }
+        }
+        n_busy_peak = std::max(n_busy_peak, busy);
+
+        server_events::publish_state(slot.id, telemetry_phase(slot.state), busy, n_busy_peak,
+                (int) slot.n_ctx, (int) slot.prompt.n_tokens());
+    }
+
+    // one event per 50 ms per slot, so a live TG meter gets ~20 updates/s
+    void emit_gen_progress(const server_slot & slot, int64_t t_now) {
+        if (!server_events::enabled() || !slot.stats.is_set()) {
+            return;
+        }
+
+        const auto it = t_gen_emit_last.find(slot.id);
+        if (it != t_gen_emit_last.end() && t_now - it->second < 50 * 1000) {
+            return;
+        }
+        t_gen_emit_last[slot.id] = t_now;
+
+        server_events::publish_gen_progress(slot.id, slot.stats.n_gen,
+                slot.stats.t_gen_ms(), slot.stats.n_gen_tps());
+    }
+
+    void emit_prompt_progress(const server_slot & slot) {
+        if (!server_events::enabled() || !slot.task || !slot.stats.is_set()) {
+            return;
+        }
+
+        // identical to the values send_partial_response() puts in progress
+        server_events::publish_prompt_progress(
+                slot.id,
+                (int) slot.task->n_tokens(),
+                (int) slot.stats.n_prompt_cached,
+                (int) slot.prompt.tokens.size(),
+                (double) slot.stats.t_elapsed_us() / 1000.0);
+    }
 };
 
