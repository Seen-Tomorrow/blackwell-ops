+//
+// Engine telemetry fan-out (/events/sse).
+//
+// The per-request stream carries prompt_progress for a client that asked for
+// it (return_progress) and timings at the end of that request. An observer
+// that does not own the request - fusion meters, the bench archive, the ops UI
+// - cannot see either, so this broadcasts the same payloads, from the same
+// counters, to any number of attached readers.
+//
+// Additive: emitters check server_events::enabled() first, so with nobody
+// attached the task loop is untouched. A subscriber that cannot keep up is
+// dropped rather than allowed to stall a decode.
+//
+static constexpr size_t ENGINE_EVENTS_MAX_QUEUE_BYTES = 1u << 20; // per subscriber
+static constexpr int64_t ENGINE_EVENTS_KEEPALIVE_MS    = 15000;
+
+static struct engine_events_hub {
+    struct subscriber {
+        std::deque<std::string> queue;
+        size_t bytes   = 0;
+        bool   dropped = false;
+    };
+
+    std::mutex              mutex;
+    std::condition_variable cv;
+
+    std::map<uint64_t, std::shared_ptr<subscriber>> subs;
+    uint64_t next_id = 1;
+    uint64_t seq     = 0;
+
+    // returns false when nobody is subscribed and the event was not serialized
+    bool publish(const char * type, json evt) {
+        std::lock_guard<std::mutex> lk(mutex);
+        if (subs.empty()) {
+            return false;
+        }
+
+        evt["seq"] = ++seq;
+
+        std::string frame = "event: ";
+        frame += type;
+        frame += "\ndata: ";
+        frame += safe_json_to_str(evt);
+        frame += "\n\n";
+
+        for (auto it = subs.begin(); it != subs.end();) {
+            auto & s = *it->second;
+            if (s.bytes + frame.size() > ENGINE_EVENTS_MAX_QUEUE_BYTES) {
+                // slow consumer: drop it instead of stalling the task loop
+                s.dropped = true;
+                s.queue.clear();
+                s.bytes = 0;
+                it = subs.erase(it);
+                continue;
+            }
+            s.queue.push_back(frame);
+            s.bytes += frame.size();
+            ++it;
+        }
+
+        cv.notify_all();
+        return true;
+    }
+} g_engine_events_hub;
+
+// removes the subscriber when the response, and therefore the streaming
+// callback holding this handle, is destroyed
+struct engine_events_handle {
+    uint64_t id = 0;
+
+    ~engine_events_handle() {
+        std::lock_guard<std::mutex> lk(g_engine_events_hub.mutex);
+        g_engine_events_hub.subs.erase(id);
+        g_engine_events_hub.cv.notify_all();
+    }
+};
+
+static server_http_res_ptr handle_engine_events_sse(const server_http_req & req) {
+    auto res = std::make_unique<server_http_res>();
+    res->status       = 200;
+    res->content_type = "text/event-stream";
+
+    auto handle = std::make_shared<engine_events_handle>();
+    auto sub    = std::make_shared<engine_events_hub::subscriber>();
+
+    {
+        std::lock_guard<std::mutex> lk(g_engine_events_hub.mutex);
+        handle->id = g_engine_events_hub.next_id++;
+        g_engine_events_hub.subs[handle->id] = sub;
+    }
+
+    // the response head is not flushed until the first body write, so send a comment
+    // frame right away: it makes the attach observable before any request happens
+    auto first = std::make_shared<bool>(true);
+
+    res->next = [sub, handle, first, &req](std::string & output) -> bool {
+        std::unique_lock<std::mutex> lk(g_engine_events_hub.mutex);
+
+        if (*first) {
+            *first = false;
+            lk.unlock();
+            output = ":\n\n";
+            return true;
+        }
+
+        auto ready = [&]() {
+            return !sub->queue.empty() || sub->dropped || req.should_stop();
+        };
+
+        if (!ready()) {
+            g_engine_events_hub.cv.wait_for(lk, std::chrono::milliseconds(ENGINE_EVENTS_KEEPALIVE_MS), ready);
+        }
+
+        if (sub->dropped || req.should_stop()) {
+            return false;
+        }
+
+        if (!sub->queue.empty()) {
+            std::string frame = std::move(sub->queue.front());
+            sub->bytes -= frame.size();
+            sub->queue.pop_front();
+            lk.unlock();
+            output = std::move(frame);
+            return true;
+        }
+
+        // SSE comment keep-alive so an idle engine does not look dead
+        lk.unlock();
+        output = ":\n\n";
+        return true;
+    };
+
+    return res;
+}
+
+namespace server_events {
+
+bool enabled() {
+    std::lock_guard<std::mutex> lk(g_engine_events_hub.mutex);
+    return !g_engine_events_hub.subs.empty();
+}
+
+void publish_prompt_progress(int id_slot, int n_total, int n_cache, int n_processed, double time_ms) {
+    // mirrors result_prompt_progress::to_json(), the payload the per-request
+    // stream sends for return_progress clients
+    g_engine_events_hub.publish("prompt_progress", json {
+        {"type",      "prompt_progress"},
+        {"slot",      id_slot},
+        {"total",     n_total},
+        {"cache",     n_cache},
+        {"processed", n_processed},
+        {"time_ms",   time_ms},
+    });
+}
+
+void publish_request_end(int id_slot, int id_task, const server_slot_stats & stats,
+        double lib_prompt_ms, int64_t lib_tokens_evaluated) {
+    // same counters the /completion timings object is built from, plus the
+    // library t_p_eval delta so both boundaries can be compared
+    g_engine_events_hub.publish("request_end", json {
+        {"type",                 "request_end"},
+        {"slot",                 id_slot},
+        {"task",                 id_task},
+        {"prompt_ms",            stats.t_prompt_ms()},
+        {"predicted_ms",         stats.t_gen_ms()},
+        {"tokens_evaluated",     stats.n_prompt_processed},
+        {"tokens_predicted",     stats.n_gen},
+        {"cache_hit_tokens",     stats.n_prompt_cached},
+        {"spec_accepted",        stats.n_draft_accepted},
+        {"spec_draft",           stats.n_draft_tokens},
+        {"lib_prompt_ms",        lib_prompt_ms},
+        {"lib_tokens_evaluated", lib_tokens_evaluated},
+    });
+}
+
+void publish_gen_progress(int id_slot, uint64_t n_decoded, double gen_ms, double tps) {
+    g_engine_events_hub.publish("gen_progress", json {
+        {"type",     "gen_progress"},
+        {"slot",     id_slot},
+        {"decoded",  n_decoded},
+        {"gen_ms",   gen_ms},
+        {"tps",      tps},
+    });
+}
+
+void publish_state(int id_slot, const char * phase, int busy, int peak, int n_ctx, int n_ctx_used) {
+    g_engine_events_hub.publish("state", json {
+        {"type",       "state"},
+        {"slot",       id_slot},
+        {"phase",      phase},
+        {"busy",       busy},
+        {"peak",       peak},
+        {"n_ctx",      n_ctx},
+        {"n_ctx_used", n_ctx_used},
+    });
+}
+
