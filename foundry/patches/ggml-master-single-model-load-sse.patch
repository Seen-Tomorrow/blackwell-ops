+// Single-model cold-boot progress bus (mirrors router /models/sse event shape).
+// Router mode uses server_models::notify_sse instead.
+static struct single_model_load_hub {
+    std::mutex mutex;
+    std::condition_variable cv;
+    json last = nullptr;
+    uint64_t seq = 0;
+    bool done = false;
+
+    void reset() {
+        std::lock_guard<std::mutex> lk(mutex);
+        last = nullptr;
+        seq = 0;
+        done = false;
+    }
+
+    void publish(json evt, bool finished) {
+        {
+            std::lock_guard<std::mutex> lk(mutex);
+            last = std::move(evt);
+            seq += 1;
+            if (finished) {
+                done = true;
+            }
+        }
+        cv.notify_all();
+    }
+} g_single_model_load_hub;
+
+static server_http_res_ptr handle_single_model_load_sse(const server_http_req & req) {
+    auto res = std::make_unique<server_http_res>();
+    res->status = 200;
+    res->content_type = "text/event-stream";
+    auto seen = std::make_shared<uint64_t>(0);
+    res->next = [seen, &req](std::string & output) -> bool {
+        std::unique_lock<std::mutex> lk(g_single_model_load_hub.mutex);
+        auto wait_pred = [&]() {
+            return g_single_model_load_hub.seq > *seen
+                || g_single_model_load_hub.done
+                || req.should_stop();
+        };
+        if (*seen == 0 && !g_single_model_load_hub.last.is_null()) {
+            *seen = g_single_model_load_hub.seq;
+            output = "data: " + safe_json_to_str(g_single_model_load_hub.last) + "\n\n";
+            return true;
+        }
+        g_single_model_load_hub.cv.wait_for(lk, std::chrono::seconds(1), wait_pred);
+        if (req.should_stop()) {
+            return false;
+        }
+        if (g_single_model_load_hub.seq > *seen) {
+            *seen = g_single_model_load_hub.seq;
+            output = "data: " + safe_json_to_str(g_single_model_load_hub.last) + "\n\n";
+            return true;
+        }
+        if (g_single_model_load_hub.done) {
+            return false;
+        }
+        output = ":\n\n";
+        return true;
+    };
+    return res;
+}
 // satisfies -Wmissing-declarations (used by llama command)
 int llama_server(int argc, char ** argv);
 
