+    // Device memory as the engine sees it. On Windows/WDDM the CUDA free number is a budget
+    // (VRAM + shared system memory), so --fit can plan against a card other models already hold.
+    this->get_memory = [this](const server_http_req &) {
+        auto res = create_response(true);
+
+        json devices = json::array();
+        for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+            ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+            size_t free_bytes  = 0;
+            size_t total_bytes = 0;
+            ggml_backend_dev_memory(dev, &free_bytes, &total_bytes);
+            const enum ggml_backend_dev_type type = ggml_backend_dev_type(dev);
+            const char * type_name = type == GGML_BACKEND_DEVICE_TYPE_GPU
+                ? "GPU"
+                : (type == GGML_BACKEND_DEVICE_TYPE_ACCEL ? "ACCEL" : "CPU");
+            devices.push_back({
+                {"index",       i},
+                {"name",        ggml_backend_dev_name(dev)},
+                {"description", ggml_backend_dev_description(dev)},
+                {"type",        type_name},
+                {"total_mib",   total_bytes / (1024 * 1024)},
+                {"free_mib",    free_bytes  / (1024 * 1024)},
+            });
+        }
+
+        res->ok({
+            {"devices",    devices},
+            {"slot_n_ctx", meta->slot_n_ctx},
+            {"model", {
+                {"name",        meta->model_name},
+                {"size_mib",    meta->model_size / (1024 * 1024)},
+                {"n_params",    meta->model_n_params},
+                {"n_ctx_train", meta->model_n_ctx_train},
+                {"ftype",       meta->model_ftype},
+            }},
+        });
+        return res;
+    };
+
