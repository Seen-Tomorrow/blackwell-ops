@@ -0,0 +1,16 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+// Blackwell OPS: every backend buffer the engine reported while allocating.
+struct server_memory_ledger_entry {
+    std::string device;
+    std::string tag;
+    std::string kind;
+    double mib = 0.0;
+};
+
+void server_memory_ledger_record(const char * device, const char * tag, const char * kind, double mib);
+
+std::vector<server_memory_ledger_entry> server_memory_ledger_entries();
