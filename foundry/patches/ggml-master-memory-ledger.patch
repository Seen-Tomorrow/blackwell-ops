diff --git a/tools/server/server-memory-ledger.cpp b/tools/server/server-memory-ledger.cpp
new file mode 100644
index 000000000..031674b59
--- /dev/null
+++ b/tools/server/server-memory-ledger.cpp
@@ -0,0 +1,32 @@
+#include "server-memory-ledger.h"
+
+#include <mutex>
+
+namespace {
+
+std::mutex g_mutex;
+std::vector<server_memory_ledger_entry> g_entries;
+
+}
+
+void server_memory_ledger_record(const char * device, const char * tag, const char * kind, double mib) {
+    if (device == nullptr || kind == nullptr) {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(g_mutex);
+
+    for (auto & e : g_entries) {
+        if (e.device == device && e.kind == kind && e.tag == (tag ? tag : "")) {
+            e.mib = mib;
+            return;
+        }
+    }
+
+    g_entries.push_back({ device, tag ? tag : "", kind, mib });
+}
+
+std::vector<server_memory_ledger_entry> server_memory_ledger_entries() {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return g_entries;
+}
