+
+// Persistent worker pool for parallel per-slot CPU sampling when multiple slots
+// generate concurrently (e.g. parallel=24 non-SPEC TG). Avoids serializing 24x
+// full-vocab top_k/top_p/softmax passes on the single server main thread.
+struct server_sample_job {
+    int              slot_id;
+    common_sampler * smpl;
+    llama_context  * ctx;
+    int              tok_idx;
+    llama_token      id;
+};
+
+class server_sample_pool {
+public:
+    explicit server_sample_pool(size_t n_threads) {
+        const size_t n_bg = n_threads > 1 ? n_threads - 1 : 0;
+        workers.reserve(n_bg);
+        for (size_t i = 0; i < n_bg; ++i) {
+            workers.emplace_back([this]() { worker_loop(); });
+        }
+    }
+
+    ~server_sample_pool() {
+        {
+            std::lock_guard<std::mutex> lk(mtx);
+            stop = true;
+        }
+        cv_work.notify_all();
+        for (auto & t : workers) {
+            if (t.joinable()) {
+                t.join();
+            }
+        }
+    }
+
+    void run(std::vector<server_sample_job> & batch_jobs) {
+        if (batch_jobs.size() < 2 || workers.empty()) {
+            for (auto & j : batch_jobs) {
+                j.id = common_sampler_sample(j.smpl, j.ctx, j.tok_idx);
+            }
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lk(mtx);
+            jobs = &batch_jobs;
+            next_idx.store(0, std::memory_order_relaxed);
+            done_count.store(0, std::memory_order_relaxed);
+            ++epoch;
+        }
+        cv_work.notify_all();
+        drain_jobs(&batch_jobs);
+        std::unique_lock<std::mutex> lk(mtx);
+        cv_done.wait(lk, [&]() {
+            return done_count.load(std::memory_order_acquire) >= batch_jobs.size();
+        });
+        jobs = nullptr;
+    }
+
+private:
+    void drain_jobs(std::vector<server_sample_job> * cur) {
+        if (!cur) return;
+        const size_t n = cur->size();
+        for (;;) {
+            const size_t i = next_idx.fetch_add(1, std::memory_order_relaxed);
+            if (i >= n) break;
+            auto & j = (*cur)[i];
+            j.id = common_sampler_sample(j.smpl, j.ctx, j.tok_idx);
+            if (done_count.fetch_add(1, std::memory_order_release) + 1 == n) {
+                std::lock_guard<std::mutex> lk(mtx);
+                cv_done.notify_one();
+            }
+        }
+    }
+
+    void worker_loop() {
+        uint64_t seen = 0;
+        for (;;) {
+            std::vector<server_sample_job> * cur = nullptr;
+            {
+                std::unique_lock<std::mutex> lk(mtx);
+                cv_work.wait(lk, [&]() { return stop || epoch != seen; });
+                if (stop) return;
+                seen = epoch;
+                cur  = jobs;
+            }
+            drain_jobs(cur);
+        }
+    }
+
+    std::vector<std::thread>         workers;
+    std::mutex                       mtx;
+    std::condition_variable          cv_work;
+    std::condition_variable          cv_done;
+    std::vector<server_sample_job> * jobs = nullptr;
+    std::atomic<size_t>              next_idx { 0 };
+    std::atomic<size_t>              done_count { 0 };
+    uint64_t                         epoch = 0;
+    bool                             stop  = false;
+};
+
