# Every text file: LF in the index AND in the checkout. Only agents edit this
# tree, on Windows, and nothing here needs CRLF — one form means `git diff` is
# raw bytes and `git add` never rewrites a file.
* text=auto eol=lf

# cmd.exe still wants CRLF inside a .bat/.cmd (labels and parenthesized blocks).
*.bat text eol=crlf
*.cmd text eol=crlf
