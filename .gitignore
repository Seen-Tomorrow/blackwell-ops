# --- OS & IDE Junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/
agent-tools/
terminals/
work/
mcps/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Node / Frontend (React + Vite) ---
node_modules/
dist/
dist-ssr/
.opencode/
*.local
.env
.env.*
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Rust / Tauri v2 ---
# This is where your 9GB lives - KILL IT
target/
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
src-tauri/runtime-bundle/
src-tauri/bin/git/
src-tauri/pi-ext/

# --- Engine packs (published as 7z release assets by majestic pack:engines) ---
# runtime/<provider>/<profile>/ holds the llama-server pack + build-info sidecar;
# it is assembled locally and shipped as a release asset, never committed.
# Factory templates under runtime/<provider>/config/ stay tracked.
src-tauri/runtime/*/*/
!src-tauri/runtime/*/config/

# --- AI / Llama Server Specific ---
# Ignore the actual server executable if you download it externally
# but keep your integration logic.
*.exe
*.dll
*.pdb
*.d
llama-server.exe

# IMPORTANT: Ignore large Model files (GGUF, etc) 
# You do NOT want to push 4GB-70GB models to GitHub
*.gguf
*.bin
models/

# --- Foundry portable toolchain (manifest.json is committed; blobs are local) ---
toolchain/VC/
toolchain/Windows Kits/
toolchain/cuda/
toolchain/vs/

# --- Build Counter (local, auto-incrementing) ---
.build_counter.json

# --- Tauri Updater Signing Key (NEVER commit!) ---
src-tauri/updater_private.key

# --- Majestic release robot (local only) ---
.majestic-out/
.majestic-backup/

# --- Temp build/installer junk ---
$tmp/
$tmp/**
tmp/
scripts/majestic/.majestic-enabled
scripts/majestic/.majestic-secrets
scripts/majestic/majestic.lock
__pycache__/

# --- Internal docs (local only — not published) ---
docs/internal/

# --- OpenCode Specific ---
.local/
opencode.db*
worktree/
snapshot/
log/

# --- pi coding agent artefacts ---
.pi-subagents/
.pi/
# Blackwell-managed pi routing doc written into the project cwd on each launch
PI.md

# --- zvec-grep (zg) workspace index — local binary state, live LOCK files ---
.zvec-grep/

# --- generic ---
VLLM/

# Generated by `npm run css:map` (ownership snapshot) - not a document.
docs/css-map.md

# Benchmark report output (npm run bench:report) - derived, regenerate on demand.
bench-out/

# Agent session state (rpi harness) - local, never shipped.
.rpi/
